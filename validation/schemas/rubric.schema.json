{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mibrahimdesign/agent-os-skill/blob/main/validation/schemas/rubric.schema.json",
  "title": "Agent OS Skill Validation Rubric",
  "description": "Normative v1 contract for Agent OS Skill validation rubrics. Rubrics are maintainer validation data, not runtime governance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rubric_id",
    "rubric_version",
    "scenario_id",
    "behavior_ids",
    "test_ids",
    "purpose",
    "preconditions",
    "observable_events",
    "machine_checks",
    "human_checks",
    "result_derivation",
    "failure_mapping",
    "evidence_requirements",
    "transcript_requirements"
  ],
  "properties": {
    "rubric_id": {
      "type": "string",
      "pattern": "^(CR-[0-9]{2}|AOS-T[0-9]{3})$"
    },
    "rubric_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "scenario_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9-]*$"
    },
    "behavior_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^AOS-B[0-9]{3}$"}
    },
    "test_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^AOS-T[0-9]{3}$"}
    },
    "purpose": {"type": "string", "minLength": 1},
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "observable_events": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "machine_checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/machineCheck"}
    },
    "human_checks": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/humanCheck"}
    },
    "result_derivation": {"$ref": "#/$defs/resultDerivation"},
    "failure_mapping": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/failureMappingEntry"}
    },
    "evidence_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "transcript_requirements": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "machineCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "evidence_source", "pass_condition", "mandatory", "on_fail"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z0-9]+-M[0-9]{2}$"},
        "question": {"type": "string", "minLength": 1},
        "evidence_source": {"type": "string", "minLength": 1},
        "pass_condition": {"type": "string", "minLength": 1},
        "mandatory": {"type": "boolean"},
        "on_fail": {"enum": ["FAIL", "PARTIAL"]},
        "sub_cases": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/subCase"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mandatory": {"const": true}}, "required": ["mandatory"]},
          "then": {"properties": {"on_fail": {"const": "FAIL"}}}
        },
        {
          "if": {"properties": {"mandatory": {"const": false}}, "required": ["mandatory"]},
          "then": {"properties": {"on_fail": {"const": "PARTIAL"}}}
        }
      ]
    },
    "subCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "input", "expected_classification"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z]{1,3}$"},
        "input": {"type": "string", "minLength": 1},
        "expected_classification": {
          "enum": ["VALID_APPROVAL_GRANTED", "INVALID_APPROVAL", "TOKEN_TEXT_PRESENT"]
        }
      }
    },
    "humanCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "question", "answers", "required"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z0-9]+-H[0-9]{2}$"},
        "question": {"type": "string", "minLength": 1},
        "answers": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["yes", "partial", "no", "not_applicable"]}
        },
        "required": {"type": "boolean"}
      }
    },
    "resultDerivation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_order", "PASS", "PARTIAL", "FAIL", "BLOCKED", "NOT_EXECUTED"],
      "properties": {
        "evaluation_order": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["NOT_EXECUTED", "BLOCKED", "FAIL", "PARTIAL", "PASS"]}
        },
        "PASS": {"type": "string", "minLength": 1},
        "PARTIAL": {"type": "string", "minLength": 1},
        "FAIL": {"type": "string", "minLength": 1},
        "BLOCKED": {"type": "string", "minLength": 1},
        "NOT_EXECUTED": {"type": "string", "minLength": 1}
      }
    },
    "failureMappingEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["condition", "result", "failure_category"],
      "properties": {
        "condition": {"type": "string", "minLength": 1},
        "result": {"enum": ["FAIL", "PARTIAL"]},
        "failure_category": {"type": "string", "pattern": "^FC-[0-9]{2}$"},
        "notes": {"type": "string"}
      }
    }
  }
}
